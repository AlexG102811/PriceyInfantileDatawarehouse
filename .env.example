# Replit provides DATABASE_URL and SESSION_SECRET for this app.
# Set these in Replit Secrets before running npm run seed to create an admin:
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Resend must have a verified sending domain. In development, the reset link
# uses REPLIT_DEV_DOMAIN automatically; set APP_BASE_URL to the public app URL
# in production.
RESEND_FROM_EMAIL=
APP_BASE_URL=
